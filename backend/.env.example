# Copy this to .env (local) or set these in Deployment → Environment Variables (Vercel/Render/Heroku)
# Sales order email ke liye ye zaroor set karo:

PORT=4000
NODE_ENV=production
MONGODB_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d

# --- Order / Quotation email (info@praco) ---
ORDER_NOTIFY_EMAIL=accounts@praco.co.uk
SALES_ORDER_FROM_EMAIL=info@praco.co.uk
QUOTATION_FROM_EMAIL=info@praco.co.uk
INFO_PROCO_EMAIL=info@praco.co.uk
INFO_PROCO_PASS=your_godaddy_password
INFO_PROCO_HOST=smtpout.secureserver.net
INFO_PROCO_PORT=587

# Same sender (fallback)
EMAIL_USER=info@praco.co.uk
EMAIL_PASS=your_godaddy_password
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_SECURE=false

# Optional
FRONTEND_URL=https://your-frontend-url.com
